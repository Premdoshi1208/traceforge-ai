# Backend only. Copy to .env; never commit real values.
GROQ_API_KEY=
DATABASE_URL=sqlite:///./traceforge.db
# Production schema migrations use a direct PostgreSQL connection.
MIGRATION_DATABASE_URL=
REASONING_MODEL=openai/gpt-oss-120b
EFFICIENT_MODEL=openai/gpt-oss-20b
APP_ENV=development
VERIFICATION_MODE=local
ADMIN_TOKEN=
SESSION_SECRET=
GITHUB_REPOSITORY=
# Use a dedicated fine-grained token: Actions read/write, Contents read.
GITHUB_TOKEN=
GITHUB_REF=main
DAILY_RUN_LIMIT=12
SESSION_RUN_LIMIT=2
MAX_MODEL_REQUESTS=8
MAX_TOKENS=18000
MAX_CONCURRENT_RUNS=1
